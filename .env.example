# StepWise — AI-Assisted College Administrative Service & Automation System
# Environment Configuration Template

# ------------------------------------------------------------------------------
# Google Gemini AI Integration (Server-Side Proxy)
# ------------------------------------------------------------------------------
# Required for AI Administrative Advisor live semantic grounding.
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# Supabase PostgreSQL & Auth Configuration
# ------------------------------------------------------------------------------
# Project URL from Supabase Project Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key (safe for browser client)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role Key (Backend / Server-Side only; NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# Application Runtime
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL="https://your-app-domain.vercel.app"

# ------------------------------------------------------------------------------
# Project Team Member Identities (Configurable)
# ------------------------------------------------------------------------------
# Override default team member names displayed in the campus portal
VITE_TEAM_MEMBER_STUDENT="Devaansh K."
VITE_TEAM_STUDENT_EMAIL="devaansh.student@campus.edu"
VITE_TEAM_MEMBER_STAFF="Staff Verification Officer"
VITE_TEAM_STAFF_EMAIL="staff.academic@campus.edu"
VITE_TEAM_MEMBER_APPROVER="Dean of Academic Affairs"
VITE_TEAM_APPROVER_EMAIL="dean.academic@campus.edu"
VITE_TEAM_MEMBER_ADMIN="System Administrator"
VITE_TEAM_ADMIN_EMAIL="admin.registrar@campus.edu"
